{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/London",
  "schedule": ["before 6am on monday"],
  "rangeStrategy": "bump",
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "platformAutomerge": false,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Ignore everything by default (third-party libs, GitHub Actions, Python runtime): no continuous churn",
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "description": "Manage only the MSW ecosystem packages; bump their floors, batched into one weekly PR",
      "matchPackageNames": [
        "/^msw-/",
        "acquisition-namespace",
        "ttl-barcoder",
        "pypulsepal",
        "one-axis-stage",
        "serial-scale-hx711",
        "serial-scale-bench",
        "rpi-camera-ensemble",
        "safe-and-collaborative-architecture"
      ],
      "enabled": true,
      "groupName": "msw packages"
    },
    {
      "description": "Non-major MSW bumps auto-merge on green CI (each cuts a release pinning the latest floors)",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Major MSW bumps land as a manual PR (review before release)",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "ignoreDeps": [
    "msw-agent"
  ]
}
