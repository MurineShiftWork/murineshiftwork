{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/London",
  "rangeStrategy": "bump",
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "platformAutomerge": false,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group all MSW namespace and hardware packages into one PR",
      "matchPackageNames": [
        "/^msw-/",
        "acquisition-namespace",
        "ttl-barcoder",
        "pypulsepal",
        "one-axis-stage",
        "serial-scale-hx711",
        "serial-scale-bench",
        "rpi-camera-ensemble",
        "safe-and-collaborative-architecture"
      ],
      "groupName": "MSW packages",
      "automerge": true,
      "labels": ["dependencies", "msw-packages"]
    },
    {
      "description": "Auto-merge non-major dependency bumps once CI is green, so each release pins the latest floors",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Major bumps always land as a manual PR (review before release)",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Group GitHub Actions version bumps (CI-only: chore, no release, manual)",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": false,
      "semanticCommitType": "chore",
      "labels": ["dependencies", "ci"]
    }
  ],
  "ignoreDeps": [
    "msw-agent"
  ]
}
