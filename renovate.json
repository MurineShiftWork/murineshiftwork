{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/London",
  "schedule": ["before 6am on monday"],
  "rangeStrategy": "bump",
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "platformAutomerge": false,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Batch all non-major updates into one weekly auto-merged PR; each merge cuts one release with the latest floors",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "weekly dependencies",
      "automerge": true
    },
    {
      "description": "Major bumps land as separate manual PRs (review before release)",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "GitHub Actions bumps: CI-only chore, manual, no release",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": false,
      "semanticCommitType": "chore",
      "labels": ["dependencies", "ci"]
    }
  ],
  "ignoreDeps": [
    "msw-agent"
  ]
}
